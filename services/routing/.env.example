# sandbox serves simulated data. production refuses to start until a live
# provider is implemented.
STABLEFLOW_ENV=sandbox
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info

# Matches docker-compose.yml. Leave unset to run on an in-memory store.
DATABASE_URL=postgresql://stableflow:stableflow_dev@localhost:55432/stableflow

# Optional. Shares rate limits between instances and caches provider quotes.
REDIS_URL=redis://localhost:56379

# Comma-separated browser origins. Empty disables cross-origin access.
CORS_ORIGINS=http://localhost:3000

RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

PROVIDER_TIMEOUT_MS=2000
PROVIDER_CONCURRENCY=4
PROVIDER_RETRIES=1
MAX_QUOTE_AGE_MS=60000

# Default weights for optimizeFor: balanced
BALANCED_WEIGHT_COST=0.5
BALANCED_WEIGHT_DURATION=0.3
BALANCED_WEIGHT_RELIABILITY=0.2

# default, solana_congestion, base_outage, bank_holiday or slow_provider
SIMULATION_SCENARIO=default

# In-memory mode only. Leave blank to have a key generated at startup.
DEV_API_KEY=
